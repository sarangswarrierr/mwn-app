# Signing material. Commit this file, never the keystore it points at.
#
# Copy to keystore.properties and fill in. `npm run keystore` generates a
# matching keystore and writes this file for you.
#
# storeFile is relative to android/, so a value of "mwn-upload.jks" resolves to
# android/mwn-upload.jks.
storeFile=mwn-upload.jks
storePassword=CHANGE_ME
keyAlias=mwn
keyPassword=CHANGE_ME
